# ============================================================
# SIMPLE TRAINING HELPER
# ============================================================

def train_lightgbm(
    X_train,
    y_train,
    X_validation=None,
    y_validation=None,
) -> LightGBMDigitEngine:
    """
    Convenience training function.
    """

    engine = (
        LightGBMDigitEngine()
    )

    engine.train(
        X_train=X_train,
        y_train=y_train,
        X_validation=X_validation,
        y_validation=y_validation,
    )

    return engine


